# 로컬 개발용 설정 템플릿 — application-local.yaml은 gitignore 대상이므로
# 이 파일을 복사해서 사용한다:
#   cp src/main/resources/application-local.yaml.example src/main/resources/application-local.yaml
spring:
  datasource:
    # docker compose up -d 로 뜨는 로컬 PostgreSQL 기준
    url: jdbc:postgresql://localhost:5432/study
    username: study
    password: study
  jpa:
    open-in-view: false
    hibernate:
      ddl-auto: validate

# 로컬에서 프론트를 띄워 API를 호출할 때 필요하다.
# 포트는 번들러마다 달라(Vite 5173, Next 3000 등) 열어둔다 — :[*]가 Spring의 포트 와일드카드 문법이다.
app:
  cors:
    allowed-origins:
      - http://localhost:[*]
      - http://127.0.0.1:[*]

# AUTH-DISABLED: 로그인 MVP 제외 (ADR-0004) — 인증 재도입 시 주석 해제
